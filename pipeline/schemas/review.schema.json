{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review.schema.json",
  "title": "Reviewer → Coder: review verdict (strict: Codex --output-schema needs additionalProperties=false and every property required)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ship", "reason", "issues"],
  "properties": {
    "ship": { "type": "boolean" },
    "reason": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "kind", "severity", "problem", "fix"],
        "properties": {
          "file": { "type": "string" },
          "kind": { "type": "string", "enum": ["test", "spec-gap", "site-issue"] },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "problem": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    }
  }
}
